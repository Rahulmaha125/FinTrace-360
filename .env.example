# FinTrace 360 - Environment Configuration Template
# Copy this file to .env and configure your local settings.
# NEVER commit the actual .env file containing credentials to source control.

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fintrace360
DB_USER=postgres
DB_PASSWORD=your_password_here

# Project Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
OUTPUTS_DIR=./outputs

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
